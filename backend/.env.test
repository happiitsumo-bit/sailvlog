# qa-engineer (T-90): backendテスト実行用の環境変数。
# docker-compose.yml の db サービス（ホスト側 localhost:5433 にマッピング済み）に対し、
# 開発用DB(sailvlog_db)とは別の sailvlog_test DB を使う。
# CIでは同じ資格情報・同じポート(5433)でpostgres serviceコンテナを立てて再現する（.github/workflows/test.yml参照）。
# 資格情報は docker-compose.yml に既に平文で存在するローカル専用の値であり秘密情報ではない。
DATABASE_URL=postgresql://sailvlog_user:sailvlog_pass@localhost:5433/sailvlog_test
JWT_SECRET=test_secret_do_not_use_in_prod
JWT_EXPIRES_IN=2h
PORT=8000
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
