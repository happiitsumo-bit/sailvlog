# ========================================
# sailvlog backend 環境変数テンプレート
# このファイルをコピーして .env を作成する
# cp .env.example .env
# ========================================

# --- データベース ---
# ローカル（Docker）: postgresql://sailvlog_user:sailvlog_pass@db:5432/sailvlog_db
# 本番: Neon の接続文字列を設定する（ホスティング構成は ARCH.md ADR-004: Vercel + Render + Neon）
DATABASE_URL=postgresql://sailvlog_user:sailvlog_pass@db:5432/sailvlog_db

# --- JWT ---
# 本番では必ず強力なランダム文字列に変更すること
# 生成方法: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 【デプロイ時の注意（m3-06, REVIEW-backend-3.md）】
#   ① assertJwtSecretConfigured.ts が本番(NODE_ENV=production)では32文字未満・既知の
#      プレースホルダ値を拒否してプロセスを起動させない。デプロイ前にRenderの環境変数
#      JWT_SECRETが32文字以上かつプレースホルダでないことを必ず確認すること
#      （満たさないまま値を変えてデプロイすると次のデプロイが起動不能になる）
#   ② JWT_SECRETを変更すると、発行済みの全JWT（有効期限2h）が即座に無効になる。
#      反省会当日にJWT_SECRETを変更してデプロイすると、その時点でログイン中の全員が
#      再ログインを強いられる。変更するなら反省会の前後を避けるタイミングで行うこと
JWT_SECRET=change_this_secret_in_production
# 本番は 2h（TASKS.md T-02 の要件）。有効期限が長いほど漏洩時の被害時間が伸びるため延ばさない。
# ローカル開発で毎回ログインし直すのが煩わしい場合のみ docker-compose.yml 側で上書きする。
JWT_EXPIRES_IN=2h

# --- バックエンドサーバー ---
PORT=8000

# --- CORS ---
# カンマ区切りで複数のオリジンを指定可能
# ローカル: http://localhost:3001
# 本番: https://sailvlog.vercel.app
CORS_ORIGIN=http://localhost:3001

# --- フロントエンド（Next.js） ---
# NEXT_PUBLIC_ プレフィックスはブラウザに公開される
# ローカル: http://localhost:8001  （Docker の外から叩くので 8001）
# 本番: Render 上の backend 公開URL（例: https://<service>.onrender.com。ARCH.md ADR-004）
NEXT_PUBLIC_API_URL=http://localhost:8001

# --- 公開ビュー(/p/[slug])のプロキシ間シークレット(R-03) ---
# GET /api/public/sessions/:slug は、Next.jsのサーバーコンポーネントが実クライアントIPを
# x-forwarded-client-ip ヘッダで転送することでレート制限/publicViewCountを実クライアント単位に
# する仕組みを持つ。このヘッダはbackendへ直接到達できる呼び出し元なら誰でも詐称できてしまうため、
# Next.jsサーバーのみが知る共有シークレットを x-internal-proxy-secret ヘッダで同送させ、
# 一致した場合のみ x-forwarded-client-ip を信用する。
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 【未設定時の挙動＝安全側デフォルト】この値を設定しない場合、backendは
# x-forwarded-client-ip ヘッダを常に無視し req.ip にフォールバックする
# （＝詐称もレート制限回避もできないが、Next経由の実クライアント単位カウントも効かない）。
# frontend側（Next.jsサーバー環境変数。NEXT_PUBLIC_ プレフィックスは付けない＝ブラウザに漏れない）
# にも同じ値を設定する必要がある（Codex担当分）。
INTERNAL_PROXY_SECRET=
