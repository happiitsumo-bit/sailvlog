"use client";
// TrimLab v2 — @react-three/fiber@8 (React18)
import { useRef, useMemo, useEffect } from "react";
import { useState } from "react";
import { Canvas, useFrame, useThree } from "@react-three/fiber";
import { OrbitControls, GizmoHelper, GizmoViewport } from "@react-three/drei";
import * as THREE from "three";
import { computePhysics, PhysicsResult, SailState } from "@/lib/sail-physics";

// ── 帆メッシュ ─────────────────────────────────────────
// PlaneGeometry の頂点をドラフト/ツイストで変形させる
function SailMesh({
  draftRatio,
  twistRatio,
  sailAngleRad,
  state,
}: {
  draftRatio: number;
  twistRatio: number;
  sailAngleRad: number;
  state: SailState;
}) {
  const meshRef = useRef<THREE.Mesh>(null);
  const SEG_W = 8;  // 横方向分割数
  const SEG_H = 12; // 縦方向分割数

  // ベースジオメトリ（縦長の帆: 幅2m × 高さ8m）
  const geometry = useMemo(() => {
    return new THREE.PlaneGeometry(2, 8, SEG_W, SEG_H);
  }, []);

  // 頂点変形: ドラフト（膨らみ）+ ツイスト（上下の捻れ）
  useEffect(() => {
    if (!meshRef.current) return;
    const geo = meshRef.current.geometry as THREE.BufferGeometry;
    const pos = geo.attributes.position;
    const cols = SEG_W + 1;
    const rows = SEG_H + 1;

    for (let row = 0; row < rows; row++) {
      const heightFactor = row / (rows - 1);  // 0=下端, 1=上端
      // ツイスト: 上端ほど帆が開く（twistRatio × 最大30°）
      const twistAngle = heightFactor * twistRatio * (Math.PI / 6);  // 最大30°
      // ドラフト: 帆の膨らみ量（抗力方向に最大0.5m）
      const draftDepth = draftRatio * 0.5;

      for (let col = 0; col < cols; col++) {
        const idx = row * cols + col;
        const x = pos.getX(idx);  // 元の横位置 [-1, 1]
        const y = pos.getY(idx);  // 元の縦位置 [-4, 4]

        // ドラフト変形: 横方向の放物線（中央が最大）
        const draft = draftDepth * (1 - (x * x));  // z方向に突き出る
        // ツイスト変形: 上端ほど帆面が開く
        const twist = Math.sin(twistAngle) * (x + 1) * 0.5;  // x方向に追加

        pos.setXYZ(idx, x + twist, y, draft);
      }
    }
    pos.needsUpdate = true;
    geo.computeVertexNormals();
  }, [draftRatio, twistRatio]);

  // 帆の色: 状態によって変化
  const sailColor = useMemo(() => {
    if (state === "stalled")    return new THREE.Color(0xc96442);  // terra
    if (state === "near-stall") return new THREE.Color(0xb8953a);  // dijon
    if (state === "luffing")    return new THREE.Color(0x888580);  // fg-mute
    return new THREE.Color(0xf5f0e8);                              // paper（良トリム）
  }, [state]);

  // 帆の向き: windDir - sheetAngle = sailAngleRad
  const rotY = -sailAngleRad;

  // 失速時の点滅
  const timeRef = useRef(0);
  useFrame((_, delta) => {
    if (!meshRef.current) return;
    if (state === "stalled") {
      timeRef.current += delta * 4;
      const flash = 0.8 + 0.2 * Math.sin(timeRef.current);
      (meshRef.current.material as THREE.MeshStandardMaterial).opacity = flash;
    } else {
      timeRef.current = 0;
      (meshRef.current.material as THREE.MeshStandardMaterial).opacity = 0.85;
    }
  });

  return (
    <mesh
      ref={meshRef}
      geometry={geometry}
      rotation={[0, rotY, 0]}
      position={[0, 2, 0]}  // 帆の下端を船甲板レベルに
      castShadow
    >
      <meshStandardMaterial
        color={sailColor}
        side={THREE.DoubleSide}
        transparent
        opacity={0.85}
        roughness={0.6}
        metalness={0.0}
      />
    </mesh>
  );
}

// ── ボート本体（簡易モデル）─────────────────────────────
function BoatHull() {
  return (
    <group>
      {/* 船体（扁平な楕円体）*/}
      <mesh position={[0, -0.3, 0]} rotation={[Math.PI / 2, 0, 0]}>
        <cylinderGeometry args={[0.5, 0.3, 4, 16]} />
        <meshStandardMaterial color={0xe8e0d4} roughness={0.8} />
      </mesh>
      {/* マスト */}
      <mesh position={[0, 4.5, 0]}>
        <cylinderGeometry args={[0.04, 0.06, 9, 8]} />
        <meshStandardMaterial color={0x888580} roughness={0.5} />
      </mesh>
      {/* ブーム */}
      <mesh position={[0.8, 0.8, 0]} rotation={[0, 0, Math.PI / 2]}>
        <cylinderGeometry args={[0.03, 0.03, 2, 8]} />
        <meshStandardMaterial color={0x888580} roughness={0.5} />
      </mesh>
    </group>
  );
}

// ── ベクトル矢印（ArrowHelper ラッパー）─────────────────
function VectorArrow({
  direction,
  length,
  color,
  origin = [0, 2, 0],
}: {
  direction: [number, number, number];
  length: number;
  color: number;
  origin?: [number, number, number];
}) {
  const dir = useMemo(() => new THREE.Vector3(...direction).normalize(), [direction]);
  const orig = useMemo(() => new THREE.Vector3(...origin), [origin]);

  const { scene } = useThree();
  useEffect(() => {
    if (length < 0.1) return;
    const arrow = new THREE.ArrowHelper(dir, orig, length, color, length * 0.2, length * 0.12);
    scene.add(arrow);
    return () => { scene.remove(arrow); };
  }, [dir, orig, length, color, scene]);

  return null;
}

// ── 3D シーン全体 ─────────────────────────────────────
function Scene({ result }: { result: PhysicsResult }) {
  // 風向矢印（水平面）
  const windDirVec: [number, number, number] = [
    Math.sin(result.apparentWindRad),
    0,
    Math.cos(result.apparentWindRad),
  ];

  // ベクトル長: 相対値を3D空間の長さ(最大3)にマップ
  const liftLen  = (result.liftRel  / 100) * 3;
  const dragLen  = (result.dragRel  / 100) * 2;
  const driveLen = (result.driveForce / 100) * 3;
  const heelLen  = (result.heelForce  / 100) * 2.5;

  // 揚力方向: 帆面法線（水平面で射影）
  const liftDir: [number, number, number] = [result.liftVec.x, 0, result.liftVec.y];
  // 抗力方向: 風と同方向
  const dragDir: [number, number, number] = [result.dragVec.x, 0, result.dragVec.y];
  // 推進力: 船首方向（z負）
  const driveDir: [number, number, number] = [0, 0, -1];
  // ヒール力: 右舷（x正）
  const heelDir: [number, number, number] = [1, 0, 0];

  return (
    <>
      {/* 照明 */}
      <ambientLight intensity={0.6} />
      <directionalLight position={[5, 10, 5]} intensity={1.2} castShadow />
      <directionalLight position={[-5, 5, -5]} intensity={0.4} />

      {/* 海面（薄い平面）*/}
      <mesh rotation={[-Math.PI / 2, 0, 0]} position={[0, -0.6, 0]} receiveShadow>
        <planeGeometry args={[20, 20]} />
        <meshStandardMaterial color={0xb0cce0} roughness={0.9} transparent opacity={0.4} />
      </mesh>

      {/* ボート */}
      <BoatHull />

      {/* 帆 */}
      <SailMesh
        draftRatio={result.draftRatio}
        twistRatio={result.twistRatio}
        sailAngleRad={result.sailAngleRad}
        state={result.state}
      />

      {/* 風向矢印（水面上） */}
      <VectorArrow
        direction={windDirVec}
        length={2.5}
        color={0x888580}
        origin={[-3, 0.2, -3]}
      />

      {/* 揚力ベクトル: sage（0x6b8e5a）*/}
      <VectorArrow direction={liftDir}  length={liftLen}  color={0x6b8e5a} origin={[0, 3, 0]} />
      {/* 抗力ベクトル: fg-dim（0xaaa69e）*/}
      <VectorArrow direction={dragDir}  length={dragLen}  color={0xaaa69e} origin={[0, 3, 0]} />
      {/* 推進力ベクトル: terra（0xc96442）*/}
      <VectorArrow direction={driveDir} length={driveLen} color={0xc96442} origin={[0, 1, 0]} />
      {/* ヒール力ベクトル: dijon（0xb8953a）*/}
      <VectorArrow direction={heelDir}  length={heelLen}  color={0xb8953a} origin={[0, 1, 0]} />

      {/* カメラコントロール */}
      <OrbitControls
        enablePan={false}
        minDistance={5}
        maxDistance={20}
        target={[0, 2, 0]}
      />

      {/* ギズモ（右下の方向インジケータ）*/}
      <GizmoHelper alignment="bottom-right" margin={[60, 60]}>
        <GizmoViewport axisColors={["#c96442", "#6b8e5a", "#5b8fa8"]} labelColor="white" />
      </GizmoHelper>
    </>
  );
}

// ── スライダー行 ──────────────────────────────────────
function ControlRow({
  label,
  subLabel,
  value,
  min,
  max,
  step,
  unit,
  onChange,
}: {
  label: string;
  subLabel: string;
  value: number;
  min: number;
  max: number;
  step: number;
  unit: string;
  onChange: (v: number) => void;
}) {
  return (
    <div style={{ display: "flex", flexDirection: "column", gap: "0.2rem" }}>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline" }}>
        <span style={{ fontFamily: "var(--font-mono)", fontSize: "0.72rem", color: "var(--fg-2)", fontWeight: 600 }}>
          {label}
        </span>
        <span style={{ fontFamily: "var(--font-mono)", fontSize: "0.65rem", color: "var(--fg-dim)" }}>
          {subLabel}
        </span>
      </div>
      <div style={{ display: "flex", alignItems: "center", gap: "0.75rem" }}>
        <input
          type="range"
          min={min}
          max={max}
          step={step}
          value={value}
          onChange={(e) => onChange(parseFloat(e.target.value))}
          style={{ flex: 1, accentColor: "var(--terra)" }}
          aria-label={`${label} ${value}${unit}`}
        />
        <span style={{
          fontFamily: "var(--font-mono)",
          fontSize: "0.78rem",
          color: "var(--fg)",
          minWidth: "3.5rem",
          textAlign: "right",
          fontWeight: 600,
        }}>
          {value}{unit}
        </span>
      </div>
    </div>
  );
}

// ── インジケータバー ──────────────────────────────────
function IndicatorRow({
  label,
  value,
  maxVal,
  color,
  unit,
}: {
  label: string;
  value: number;
  maxVal: number;
  color: string;
  unit?: string;
}) {
  const pct = Math.min(100, (value / maxVal) * 100);
  return (
    <div style={{ display: "flex", flexDirection: "column", gap: "0.2rem" }}>
      <div style={{ display: "flex", justifyContent: "space-between" }}>
        <span style={{ fontFamily: "var(--font-mono)", fontSize: "0.65rem", color: "var(--fg-mute)" }}>{label}</span>
        <span style={{ fontFamily: "var(--font-mono)", fontSize: "0.65rem", color, fontWeight: 700 }}>
          {value}{unit ?? ""}
        </span>
      </div>
      <div style={{ height: "3px", background: "var(--border-strong)", borderRadius: "2px", overflow: "hidden" }}>
        <div style={{
          height: "100%",
          width: `${pct}%`,
          background: color,
          borderRadius: "2px",
          transition: "width 0.12s",
        }} />
      </div>
    </div>
  );
}

// ── 状態設定 ─────────────────────────────────────────
const STATE_CONFIG: Record<SailState, { label: string; color: string; icon: string }> = {
  luffing:      { label: "Luffing",    color: "var(--fg-mute)", icon: "↑" },
  good:         { label: "Good Trim",  color: "var(--sage)",    icon: "✓" },
  "near-stall": { label: "Near Stall", color: "var(--dijon)",   icon: "⚠" },
  stalled:      { label: "Stalled",    color: "var(--terra)",   icon: "✕" },
};

function windDirLabel(deg: number): string {
  if (deg < 50)  return "close-hauled";
  if (deg < 80)  return "close reach";
  if (deg < 110) return "beam reach";
  if (deg < 150) return "broad reach";
  return "run";
}

// ── メインコンポーネント ──────────────────────────────
export default function TrimSimulator() {
  const [sheetAngle,     setSheetAngle]     = useState(10);
  const [mastBend,       setMastBend]       = useState(0.3);
  const [windSpeedKnots, setWindSpeedKnots] = useState(12);
  const [windDirDeg,     setWindDirDeg]     = useState(45);

  const result = useMemo(
    () => computePhysics({ sheetAngle, mastBend, windSpeedKnots, windDirDeg }),
    [sheetAngle, mastBend, windSpeedKnots, windDirDeg],
  );

  const stateConf = STATE_CONFIG[result.state];
  const ldColor = result.liftDragRatio > 4
    ? "var(--terra)"
    : result.liftDragRatio > 2
      ? "var(--dijon)"
      : "var(--fg-mute)";

  return (
    <div style={{
      background: "var(--card)",
      border: "1px solid var(--border)",
      borderRadius: "var(--radius-lg)",
      overflow: "hidden",
    }}>
      {/* ヘッダー */}
      <div style={{
        padding: "0.85rem 1.25rem",
        borderBottom: "1px solid var(--border)",
        display: "flex",
        alignItems: "center",
        gap: "0.75rem",
      }}>
        <span style={{
          fontFamily: "var(--font-display)",
          fontSize: "1rem",
          fontWeight: 700,
          color: "var(--fg)",
          letterSpacing: "-0.01em",
        }}>
          TrimLab
        </span>
        <span style={{ fontFamily: "var(--font-mono)", fontSize: "0.65rem", color: "var(--fg-dim)" }}>
          SAIL TRIM SIMULATOR · N9-L5
        </span>
        <span
          aria-live="polite"
          aria-atomic="true"
          style={{
            marginLeft: "auto",
            display: "inline-flex",
            alignItems: "center",
            gap: "0.3rem",
            fontFamily: "var(--font-mono)",
            fontSize: "0.72rem",
            color: stateConf.color,
            fontWeight: 700,
          }}
        >
          <span aria-hidden="true">{stateConf.icon}</span>
          {stateConf.label}
        </span>
      </div>

      {/* 3D Canvas */}
      <div
        style={{ height: "360px", background: "var(--paper)" }}
        aria-label={`セールトリム3Dビュー。推進力 ${result.driveForce}、ヒール力 ${result.heelForce}、状態 ${stateConf.label}`}
        role="img"
      >
        <Canvas
          camera={{ position: [6, 5, 8], fov: 45 }}
          shadows
          gl={{ antialias: true }}
        >
          <Scene result={result} />
        </Canvas>
      </div>

      {/* 凡例 */}
      <div style={{
        padding: "0.5rem 1.25rem",
        borderTop: "1px solid var(--border)",
        display: "flex",
        gap: "1.2rem",
        flexWrap: "wrap",
      }}>
        {[
          { color: "#c96442", label: "Drive (推進力)" },
          { color: "#b8953a", label: "Heel (ヒール力)" },
          { color: "#6b8e5a", label: "Lift (揚力)" },
          { color: "#aaa69e", label: "Drag (抗力)" },
        ].map(({ color, label }) => (
          <div key={label} style={{ display: "flex", alignItems: "center", gap: "0.4rem" }}>
            <div style={{ width: 10, height: 3, background: color, borderRadius: 2 }} />
            <span style={{ fontFamily: "var(--font-mono)", fontSize: "0.62rem", color: "var(--fg-mute)" }}>
              {label}
            </span>
          </div>
        ))}
        <span style={{
          marginLeft: "auto",
          fontFamily: "var(--font-mono)",
          fontSize: "0.6rem",
          color: "var(--fg-dim)",
        }}>
          ドラッグで回転 · ホイールでズーム
        </span>
      </div>

      {/* コントロールパネル */}
      <div style={{
        padding: "1rem 1.25rem",
        borderTop: "1px solid var(--border)",
        display: "grid",
        gridTemplateColumns: "1fr 1fr",
        gap: "0.65rem 1.5rem",
      }}>
        <div style={{
          fontFamily: "var(--font-mono)",
          fontSize: "0.65rem",
          color: "var(--fg-dim)",
          letterSpacing: "0.08em",
          gridColumn: "1/-1",
        }}>
          CONTROLS
        </div>
        <ControlRow
          label="Sheet Angle"
          subLabel="帆の開き角"
          value={sheetAngle}
          min={0}
          max={30}
          step={1}
          unit="°"
          onChange={setSheetAngle}
        />
        <ControlRow
          label="Mast Bend"
          subLabel="マストベンド (N9-L5)"
          value={mastBend}
          min={0}
          max={1}
          step={0.05}
          unit=""
          onChange={setMastBend}
        />
        <ControlRow
          label="Wind Speed"
          subLabel="真風速"
          value={windSpeedKnots}
          min={0}
          max={30}
          step={1}
          unit=" kt"
          onChange={setWindSpeedKnots}
        />
        <ControlRow
          label="Wind Direction"
          subLabel={windDirLabel(windDirDeg)}
          value={windDirDeg}
          min={30}
          max={180}
          step={5}
          unit="°"
          onChange={setWindDirDeg}
        />
      </div>

      {/* インジケータ */}
      <div style={{
        padding: "0.85rem 1.25rem 1.1rem",
        borderTop: "1px solid var(--border)",
        display: "grid",
        gridTemplateColumns: "1fr 1fr",
        gap: "0.55rem 1.5rem",
      }}>
        <div style={{
          fontFamily: "var(--font-mono)",
          fontSize: "0.65rem",
          color: "var(--fg-dim)",
          letterSpacing: "0.08em",
          gridColumn: "1/-1",
        }}>
          INDICATORS
        </div>
        <IndicatorRow label="Lift"  value={result.liftRel}   maxVal={100} color="var(--sage)" />
        <IndicatorRow label="Drag"  value={result.dragRel}   maxVal={100} color="var(--fg-dim)" />
        <IndicatorRow label="Drive" value={result.driveForce} maxVal={100} color="var(--terra)" />
        <IndicatorRow label="Heel"  value={result.heelForce}  maxVal={100} color="var(--dijon)" />

        {/* スカラー指標 */}
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          <span style={{ fontFamily: "var(--font-mono)", fontSize: "0.65rem", color: "var(--fg-mute)" }}>
            L/D Ratio
          </span>
          <span style={{ fontFamily: "var(--font-mono)", fontSize: "0.72rem", color: ldColor, fontWeight: 700 }}>
            {result.liftDragRatio.toFixed(1)}
          </span>
        </div>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          <span style={{ fontFamily: "var(--font-mono)", fontSize: "0.65rem", color: "var(--fg-mute)" }}>
            Angle of Attack
          </span>
          <span style={{ fontFamily: "var(--font-mono)", fontSize: "0.72rem", color: "var(--fg-2)", fontWeight: 600 }}>
            {result.angleOfAttackDeg}°
          </span>
        </div>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          <span style={{ fontFamily: "var(--font-mono)", fontSize: "0.65rem", color: "var(--fg-mute)" }}>
            Stall Angle
          </span>
          <span style={{ fontFamily: "var(--font-mono)", fontSize: "0.72rem", color: "var(--fg-dim)", fontWeight: 600 }}>
            {result.stallAngleDeg}°
          </span>
        </div>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          <span style={{ fontFamily: "var(--font-mono)", fontSize: "0.65rem", color: "var(--fg-mute)" }}>
            Draft
          </span>
          <span style={{ fontFamily: "var(--font-mono)", fontSize: "0.72rem", color: "var(--fg-2)", fontWeight: 600 }}>
            {Math.round(result.draftRatio * 100)}%
          </span>
        </div>
      </div>
    </div>
  );
}
